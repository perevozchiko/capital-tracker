CAPITAL_TRACKER_PUBLIC_ORIGIN=https://fin.anasko.net
CAPITAL_TRACKER_USERNAME=andrei
# Replace with the complete output of: capital-tracker hash-password
CAPITAL_TRACKER_PASSWORD_HASH='$2a$10$REPLACE_WITH_YOUR_GENERATED_HASH'
# Optional second factor for new browsers. Generate with:
# CAPITAL_TRACKER_USERNAME=andrei capital-tracker generate-totp
# Add the generated secret to Authy (6 digits), then uncomment and replace below.
# CAPITAL_TRACKER_TOTP_SECRET='REPLACE_WITH_YOUR_GENERATED_BASE32_SECRET'
# Optional marker for a test instance, shown on every screen:
# CAPITAL_TRACKER_INSTANCE_LABEL='DEV'
